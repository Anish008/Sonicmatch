  {
    "test_id": "subjective_bass_01",
    "description": "User asking about bass quality for hip-hop",
    "query_type": "subjective",
    "should_route_to_rag": true,
    "user_preference": {
      "genres": ["hip-hop", "rap", "trap"],
      "favorite_artists": ["Kendrick Lamar", "Travis Scott"],
      "favorite_tracks": [],
      "sound_preferences": {
        "bass": 0.9,
        "mids": 0.6,
        "treble": 0.5,
        "soundstage": 0.5,
        "detail": 0.7
      },
      "primary_use_case": "casual",
      "budget_min": 100,
      "budget_max": 300,
      "wireless_required": false,
      "anc_required": false,
      "open_back_acceptable": false
    },
    "expected_relevant_chunks": [
      {
        "headphone": "sony-wh-1000xm4",
        "keywords": ["bass", "sub-bass", "low-end", "hip-hop", "punchy"]
      },
      {
        "headphone": "beats-studio3",
        "keywords": ["bass-heavy", "beats", "low-frequency"]
      }
    ],
    "expected_top_match": {
      "slug": "sony-wh-1000xm4",
      "reason": "Strong bass response praised in reviews, great for hip-hop"
    }
  },
